# URL da API vista pelo servidor Next (não é exposta ao browser)
API_URL=http://localhost:4333

# URL pública do front. Se começar com https://, o cookie de sessão é Secure
APP_URL=http://localhost:4000

# Mostra o atalho de usuários de teste (seed) na tela de login
NEXT_PUBLIC_SHOW_TEST_USERS=true

# Botão "Simular erro" na modal de transferência (lido no servidor, em tempo de execução)
ENABLE_ERROR_SIMULATOR=false

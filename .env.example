# Variáveis do docker-compose.yml (ambiente completo via Docker).
# Copie para .env. O api/.env continua sendo usado só no `npm run dev`.

DATABASE_NAME=carteiraFinanceiraBolt
DATABASE_PASSWORD=12345678

# Portas expostas na sua máquina
MYSQL_PORT=4306
API_PORT=4333

# Gere um valor aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo

# Porta do Redis na sua máquina
REDIS_PORT=4379

# Front: porta na sua máquina e atalho dos usuários de teste na tela de login
FRONT_PORT=4000
SHOW_TEST_USERS=true

# Botão "Simular erro" na modal de transferência (runtime: basta recriar o container, sem rebuild)
ENABLE_ERROR_SIMULATOR=false

# Login da documentação da API (/docs/swagger). Vazias, a documentação fica aberta
SWAGGER_USER=admin
SWAGGER_PASSWORD=troque-esta-senha
